# ── Peach Protocol Test Configuration ────────────────────────────────────────

# 测试目标地址（一般不需要修改）
APP_URL=https://peach-swap.vercel.app

# 是否显示浏览器窗口（本地调试建议 false；无 UI 服务器需配合 Xvfb 使用）
HEADLESS=false

# 超时配置（毫秒）
PLAYWRIGHT_TIMEOUT_MS=60000
ACTION_TIMEOUT_MS=15000

# ── 路由选择 ──────────────────────────────────────────────────────────────────
# 从 Dashboard 运行时留空（由 Dashboard 控制选择）；
# 直接命令行运行时填写逗号分隔的路由名称。
# 可用路由：Uniswap V2/V3/V4, PancakeSwap V1/V2/V3, Thena V3, BiSwap 等
# 示例：PEACH_ROUTES=Uniswap V2,PancakeSwap V3
PEACH_ROUTES=

# ── MetaMask 扩展配置 ─────────────────────────────────────────────────────────
# MetaMask 扩展目录路径（从 Chrome 扩展目录获取）
#
# macOS 示例：
#   /Users/你的用户名/Library/Application Support/Google/Chrome/Default/Extensions/nkbihfbeogaeaoehlefnkodbefgpgknn/13.x.x_0
#
# Windows 示例：
#   C:\Users\你的用户名\AppData\Local\Google\Chrome\User Data\Default\Extensions\nkbihfbeogaeaoehlefnkodbefgpgknn\13.x.x_0
#
# 查找方法：Chrome 地址栏输入 chrome://version/ → 找到"个人资料路径" → 进入 Extensions 目录
WALLET_EXTENSION_PATH=

# MetaMask 解锁密码
WALLET_PASSWORD=your_metamask_password

# 浏览器 Profile 目录（持久化保存扩展状态，首次运行后自动创建）
WALLET_USER_DATA_DIR=.playwright-wallet-profile

# ── 测试钱包地址 ──────────────────────────────────────────────────────────────
# 钱包地址（可选，用于连接断言；EXECUTE_SWAP=true 时必填，用于余额验证）
WALLET_ADDRESS=0x你的钱包地址

# ── 首次初始化（导入钱包助记词）────────────────────────────────────────────────
# 仅首次运行时需要，MetaMask 会自动导入钱包。
# ⚠️  初始化完成后请删除此行，避免助记词泄露。
# WALLET_SEED_PHRASE=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12

# ── BSC 链上余额查询（可选）──────────────────────────────────────────────────
# EXECUTE_SWAP=true 时用于验证链上余额变化。使用公共节点无需 API Key。
BSC_RPC_URL=https://bsc-dataseed.binance.org/

# ── Swap 执行设置 ─────────────────────────────────────────────────────────────
# 每次 swap 的支付金额（BNB）
SWAP_PAY_AMOUNT=0.001

# 是否发送真实链上交易
# false（默认/安全）：仅验证报价，不消耗 BNB 和 Gas
# true：执行真实交易，需要钱包持有足够 BNB
# 注意：Dashboard 上的「发送真实交易」开关会覆盖此值
EXECUTE_SWAP=false

# ── Terminal 代币测试配置 ──────────────────────────────────────────────────────
# coin_list API 基础地址（路径为 /v1/bsc/pro/coin_list）
TERMINAL_API_BASE=https://api.cipheron.org
# coin_list API 认证（HTTP Basic Auth，默认值已内置，无需填写）
# TERMINAL_API_USER=peach
# TERMINAL_API_PASS=VncP3WpLyDHPWczf
# coin_list 过滤标签（new / trending / gainer-loser）
TERMINAL_TAG=trending
# 时间窗口（1h / 4h / 24h），仅 gainer-loser 时有效
TERMINAL_DATE_TYPE=24h
# 要测试的代币数量（对应 page_size，默认 20）
TERMINAL_TOKEN_COUNT=20
# You Pay 金额（BNB）
TERMINAL_PAY_AMOUNT=0.0001
# USD 价值比率下限（默认 0.5 = 50%）
USD_RATIO_THRESHOLD=0.5

# ── TEST_ALL_ROUTES 模式控制 ──────────────────────────────────────────────────
# true  → 模式 A：逐条测试全部 24 条路由，每条各执行一次 swap（忽略 PEACH_ROUTES）
# false → 模式 B：COMBINED（PEACH_ROUTES ≥ 2 条时）
#           Phase 1：所有选中路由同时激活 → 一次组合 swap
#           Phase 2：每条路由单独 → 各一次 swap
#         模式 C：单路由（PEACH_ROUTES ≤ 1 条时，默认 Uniswap V3）
# 注意：Dashboard 上的「测试全部路由」开关会覆盖此值
TEST_ALL_ROUTES=false
