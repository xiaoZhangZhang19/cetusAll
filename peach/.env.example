# ── Peach Protocol Test Configuration ────────────────────────────────────────

# 测试目标地址。链前缀在 URL 路径里（/bsc/*、/arc-testnet/*），
# 不带前缀的 /swap /limit /terminal 会被前端自动重定向到当前默认链。
APP_URL=https://test-peachswap.vercel.app

# 是否显示浏览器窗口。
# 没有浏览器扩展，HEADLESS=true 可以真正无头运行，
# 不需要 Xvfb，也不需要把窗口移到屏幕外。
# 本地调试想看浏览器行为时设为 false。
HEADLESS=false

# 超时配置（毫秒）
PLAYWRIGHT_TIMEOUT_MS=60000
ACTION_TIMEOUT_MS=15000

# ── 测试链选择 ────────────────────────────────────────────────────────────────
# 决定 URL 前缀、RPC、chainId、原生币和路由集合。登记在 src/config/chains.ts。
#   bsc          BNB Smart Chain（chainId 56，   /bsc/*，   原生币 BNB， 25 条路由）
#   arc-mainnet  ARC Mainnet    （chainId 5042， /arc/*，   原生币 USDC，16 条路由）
#
# 留空时按 E2E_CHAIN_ID 反查链，两者都没有则回退 bsc。
# Dashboard「多路由兑换」卡片上的链选择器会覆盖此值。
PEACH_CHAIN=bsc

# ── 路由选择 ──────────────────────────────────────────────────────────────────
# 从 Dashboard 运行时留空（由 Dashboard 控制选择）；
# 直接命令行运行时填写逗号分隔的路由名称。
# 名称大小写/空格不敏感（见 swap.page.ts 的 normalizeRouteName）。
#   bsc:         Uniswap V2/V3/V4, PancakeSwap V1/V2/V3, Thena V3, Peach PQF 等
#   arc-mainnet: Uniswap V2/V3/V4, SushiSwap V2/V3, AchSwap V2/V3,
#                Peach Launchpad, Peach PQF, Topaz CL, Aerodrome V3 等
# 示例：PEACH_ROUTES=Uniswap V2,PancakeSwap V3
PEACH_ROUTES=

# ── E2E Wallet（注入式钱包）配置 ──────────────────────────────────────────────
# 测试在页面里注入一个假的 EIP-1193 provider（"E2E Wallet"），
# 签名和广播由 Node 侧的 ethers 用私钥完成，页面永远拿不到私钥。
#
# ⚠️  安全提示
#   - 注入钱包会在无人工确认的情况下直接广播交易，主网上就是真钱。
#     请只使用专用测试钱包，并且只放需要的最小金额。
#   - .env 已在 .gitignore 中，切勿提交。

# 测试钱包私钥，0x 开头的 64 位十六进制
E2E_PRIVATE_KEY=0x你的测试私钥

# RPC 节点。bridge 用它透传读链请求、估 gas、广播交易和查回执。
# 余额断言也共用同一份地址，避免交易和查询指向不同的链。
#
# 三档优先级（高 → 低）：
#   1. E2E_RPC_URL            显式覆盖，无视当前链，一般只在临时排查时用
#   2. E2E_RPC_URL_<链KEY>    按链配置，推荐方式（key 里的 "-" 换成 "_" 并大写）
#   3. src/config/chains.ts   内置的默认节点 + 备用列表
#
# ⚠️ BSC 不要用 bsc.publicnode.com：它拒绝 eth_getTransactionReceipt
#    （403 archive token），等回执会一直卡住。
E2E_RPC_URL=
E2E_RPC_URL_BSC=https://bsc-dataseed.bnbchain.org
E2E_RPC_URL_ARC_MAINNET=https://arc-rpc.publicnode.com

# 链 ID。仅在 PEACH_CHAIN 留空时用于反查链；设了 PEACH_CHAIN 就以后者为准。
#   BNB Smart Chain = 56     （/bsc/*）
#   ARC Mainnet     = 5042   （/arc/*，原生币就是 USDC）
E2E_CHAIN_ID=56

# ── 测试钱包地址 ──────────────────────────────────────────────────────────────
# 可选。留空时自动由 E2E_PRIVATE_KEY 推导，一般不需要填。
WALLET_ADDRESS=

# ── Swap 执行设置 ─────────────────────────────────────────────────────────────
# 每次 swap 的支付金额（以支付币种计）。
#
# 保持默认值 0.001 时，高单价币会自动按 chains.ts 的 payAmountByToken 降量级：
#   cirBTC ≈ $82,000/枚 → 自动用 0.000001（≈$0.08），否则 0.001 就是 $82 一笔
# 改成其它值即视为「刻意指定」，所有币种一律使用该值，不再按币种覆盖。
SWAP_PAY_AMOUNT=0.001

# You Pay / You Receive 代币地址。留空时用当前链的默认币对：
#   bsc:         BNB  → USDT
#   arc-mainnet: USDC → EURC（实测 16 条路由里 9 条可报价；
#                cirBTC 0x171a… 流动性稀薄，逐条路由模式几乎都报不出价）
# ⚠️ ARC 上原生币就是 USDC：0xeeee…（原生占位）与
#    0x3600000000000000000000000000000000000000（ERC-20 precompile 视图）
#    是同一份余额，不能互相组成币对。
SWAP_PAY_TOKEN=
SWAP_RECEIVE_TOKEN=

# 是否发送真实链上交易
# false（默认/安全）：仅验证报价，不消耗原生币和 Gas
# true：执行真实交易，需要钱包持有足够原生币
# 注意：Dashboard 上的「发送真实交易」开关会覆盖此值
EXECUTE_SWAP=false

# ── Terminal 代币测试配置 ──────────────────────────────────────────────────────
# coin_list API 基础地址（路径为 /v1/bsc/pro/coin_list）
TERMINAL_API_BASE=https://api.cipheron.org
# coin_list API 认证（HTTP Basic Auth）。默认值已内置在代码里，一般无需填写；
# TERMINAL_API_USER=peach
# TERMINAL_API_PASS=<向团队索取>
# coin_list 过滤标签（new / trending / gainer-loser）
TERMINAL_TAG=trending
# 时间窗口（1h / 4h / 24h），仅 gainer-loser 时有效
TERMINAL_DATE_TYPE=24h
# 要测试的代币数量（对应 page_size，默认 20）
TERMINAL_TOKEN_COUNT=20
# You Pay 金额（BNB）
TERMINAL_PAY_AMOUNT=0.0001
# USD 价值比率下限（默认 0.5 = 50%）
USD_RATIO_THRESHOLD=0.5

# ── TEST_ALL_ROUTES 模式控制 ──────────────────────────────────────────────────
# true  → 模式 A：逐条测试当前链的全部路由，每条各执行一次 swap（忽略 PEACH_ROUTES）
# false → 模式 B：COMBINED（PEACH_ROUTES ≥ 2 条时）
#           Phase 1：所有选中路由同时激活 → 一次组合 swap
#           Phase 2：每条路由单独 → 各一次 swap
#         模式 C：单路由（PEACH_ROUTES ≤ 1 条时，默认 Uniswap V3）
# 注意：Dashboard 上的「测试全部路由」开关会覆盖此值
TEST_ALL_ROUTES=false
