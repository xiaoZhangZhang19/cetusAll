# ── Cetus Protocol Test Configuration ────────────────────────────────────────

APP_URL=https://app.cetus.zone
SUI_NETWORK=mainnet

# RPC 节点已内置在 src/config/networks.ts，无需配置。
# 仅在需要使用自建/付费节点时才取消注释覆盖。
# 注意：官方 fullnode.mainnet.sui.io 已停止支持 JSON-RPC，填了会被自动忽略。
# SUI_RPC_URL=https://sui-rpc.publicnode.com

# 是否显示浏览器窗口（本地调试建议 false）
HEADLESS=false

# 超时配置（毫秒）
PLAYWRIGHT_TIMEOUT_MS=120000
EXPECT_TIMEOUT_MS=15000
ACTION_TIMEOUT_MS=15000

DEFAULT_SLIPPAGE_BPS=100

# ── 钱包配置 ──────────────────────────────────────────────────────────────────
# 只用私钥签名，不需要安装任何浏览器扩展。
#
# 原理：往页面注入一个符合 Sui Wallet Standard 的钱包，dApp 发来的签名请求
# 经 Playwright 的 exposeFunction 桥接到 Node 侧，用私钥完成签名。
# 实测 Cetus swap 只调 sui:signTransaction，由前端自己广播交易。
#
# 注入的钱包在 Cetus 连接弹窗里显示为 "Suiet"（见 src/wallet/injected-controller.ts）。
# 这个名字不能随意改 —— Cetus 的弹窗只渲染固定白名单里的 18 个钱包，
# 名字不在清单内的钱包即使注册成功也不会显示出来。

# 测试钱包地址
TEST_WALLET_ADDRESS=0x你的SUI钱包地址

# 测试钱包私钥（suiprivkey1... bech32 格式）
#
# ⚠️  请勿提交到 Git
# ⚠️  必须与 TEST_WALLET_ADDRESS 是同一个钱包，否则节点会拒绝交易：
#       Invalid user signature: Required Signature from 0x... is absent
#     校验命令: npm run check:wallet
WALLET_PRIVATE_KEY=suiprivkey1你的私钥

# true  = 只签名 + dryRun，不广播上链（验证交易有效性，不花 gas 也不动本金）
# false = 真实成交，会消耗 gas 和本金
#
# 注意：设为 true 时，依赖前端成功提示的用例（如 swap.spec.ts）会失败，
# 因为交易根本没广播。只验证交易有效性请参考 injected-wallet-swap.spec.ts，
# 断言 getWalletActivity(page).dryRunStatuses。
WALLET_DRY_RUN=false

# ── Swap 测试参数 ─────────────────────────────────────────────────────────────
SWAP_INPUT_TYPE=0x2::sui::SUI
SWAP_OUTPUT_TYPE=0xdba34672e30cb065b1f93e3ab55318768fd6fef66c15942c9f7cb846e2f900e7::usdc::USDC
SWAP_FROM_TOKEN_SYMBOL=SUI
SWAP_TO_TOKEN_SYMBOL=USDC
SWAP_INPUT_AMOUNT_UI=0.1

# ── Limit Order 测试参数 ──────────────────────────────────────────────────────
LIMIT_INPUT_TYPE=0x2::sui::SUI
LIMIT_OUTPUT_TYPE=0xdba34672e30cb065b1f93e3ab55318768fd6fef66c15942c9f7cb846e2f900e7::usdc::USDC
LIMIT_INPUT_AMOUNT_UI=5.5

# ── CLMM 测试参数 ─────────────────────────────────────────────────────────────
CLMM_POOL_BASE_SYMBOL=SUI
CLMM_POOL_QUOTE_SYMBOL=USDC
CLMM_INPUT_TOKEN_SYMBOL=SUI
CLMM_INPUT_AMOUNT_UI=0.1
CLMM_ADD_MORE_AMOUNT_UI=0.01
CLMM_REMOVE_TOKEN_SYMBOL=SUI

# ── DLMM 测试参数 ─────────────────────────────────────────────────────────────
DLMM_POOL_BASE_SYMBOL=SUI
DLMM_POOL_QUOTE_SYMBOL=USDC
DLMM_INPUT_AMOUNT_UI=0.1
DLMM_ADD_MORE_AMOUNT_UI=0.01
DLMM_REMOVE_TOKEN_SYMBOL=SUI

# ── Token decimals（精度测试专用，一般无需修改）──────────────────────────────
MEOW_DECIMAL=5
SBOX_DECIMAL=9

# ── 路由降级测试 ──────────────────────────────────────────────────────────────
# Cetus findRouter API 的 URL glob 模式
FIND_ROUTER_URL_PATTERN=https://api-sui.cetus.zone/router_v3/find_routes**

# ── Route Execution Test（可选）───────────────────────────────────────────────
# 要测试的路由列表（逗号分隔，名称与 src/config/routes.ts 的 CETUS_ROUTES 一致）
# 留空则默认使用 DeepBook V3 单路由
# SELECTED_CETUS_ROUTES=Kriya V2,Kriya V3,Aftermath

# 是否遍历 CETUS_ROUTES 中每一条路由各做一次 swap
# TEST_ALL_ROUTES=false

# 是否执行真实链上交易（false = 只验证报价）
# EXECUTE_SWAP=false
