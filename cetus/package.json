    "@cetusprotocol/aggregator-sdk": "^1.5.2",
    "@mysten/sui": "^2.15.0",
    "@pythnetwork/hermes-client": "^3.1.0",
    "dotenv": "^17.4.2",
    "zod": "^3.25.76"
