    "test:e2e:limit:below": "playwright test validation-suite/e2e/limit-above-market-order.spec.ts",
    "test:e2e:limit:cancel": "playwright test validation-suite/e2e/limit-cancel-order.spec.ts",
    "test:e2e:limit:history": "playwright test validation-suite/e2e/limit-order-history.spec.ts",
    "test:e2e:dca:total": "playwright test validation-suite/e2e/dca-total-order.spec.ts",
    "test:e2e:dca:per-order": "playwright test validation-suite/e2e/dca-per-order.spec.ts",
