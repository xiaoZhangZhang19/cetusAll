    "test:e2e:deepbook:spot:sell": "playwright test validation-suite/e2e/deepbook-spot-sell.spec.ts",
    "test:e2e:deepbook:spot:insufficient": "playwright test validation-suite/e2e/deepbook-spot-insufficient.spec.ts",
