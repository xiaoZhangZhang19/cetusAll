    "test:integration:watch": "vitest --config vitest.config.ts",
    "test:e2e:smoke": "playwright test validation-suite/e2e/limit-connect-wallet.spec.ts validation-suite/e2e/limit-insufficient-balance.spec.ts validation-suite/e2e/limit-zero-rate.spec.ts validation-suite/e2e/swap-insufficient-balance.spec.ts"
