{
  "name": "sui-defi-qa",
  "version": "0.1.0",
  "private": true,
  "description": "Cetus mainnet swap automated testing with Playwright, Vitest, and @mysten/sui",
  "type": "module",
  "scripts": {
    "check:env": "node scripts/check-env.mjs",
    "test": "npm run test:integration && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "report:e2e": "playwright show-report",
    "report:allure": "allure generate allure-results --clean -o allure-report && allure open allure-report",
    "report:allure:generate": "allure generate allure-results --clean -o allure-report",
    "report:allure:open": "allure open allure-report",
    "prepare": "echo 'skipping playwright install in prepare'",
    "codegen": "tsx scripts/codegen-with-extension.ts",
    "test:e2e:swap": "playwright test validation-suite/e2e/swap.spec.ts",
    "test:e2e:swap:route": "playwright test validation-suite/e2e/swap-route.spec.ts",
    "test:e2e:swap:balance": "playwright test validation-suite/e2e/swap-insufficient-balance.spec.ts",
    "test:e2e:swap:precision": "playwright test validation-suite/e2e/swap-decimal-precision.spec.ts",
    "test:e2e:swap:impact": "playwright test validation-suite/e2e/swap-high-price-impact.spec.ts",
    "test:e2e:swap:dust": "playwright test validation-suite/e2e/swap-dust.spec.ts",
