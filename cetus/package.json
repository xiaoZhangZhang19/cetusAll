    "test:e2e:limit:0": "playwright test validation-suite/e2e/limit-zero-rate.spec.ts",
    "test:e2e:limit:insufficient": "playwright test validation-suite/e2e/limit-insufficient-balance.spec.ts",
    "test:e2e:limit:dust": "playwright test validation-suite/e2e/limit-dust-amount.spec.ts",
