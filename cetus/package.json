    "test:e2e:clmm:zap:increase": "playwright test validation-suite/e2e/clmm-zap-increase.spec.ts",
    "test:e2e:clmm:zap:out": "playwright test validation-suite/e2e/clmm-zap-out.spec.ts",
    "test:e2e:clmm:remove": "playwright test validation-suite/e2e/clmm-remove-liquidity.spec.ts",
    "test:e2e:dlmm:open": "playwright test validation-suite/e2e/dlmm-open-position.spec.ts",
